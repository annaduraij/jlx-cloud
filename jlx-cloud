#!/usr/bin/env bash
# Author: Jay Annadurai
# Project: jlx-cloud
# Date: 22 September 2026
# File: jlx-cloud
# Description: Selects a minimal or host-oriented dot-jay profile and provisions an Ubuntu cloud system.

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# defaults.env is part of this repository's trusted interface.
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/config/defaults.env"

PROVIDER="ubuntu"
TARGET_USER="ubuntu"
HOST_MODE=false
DRY_RUN=false
COMMAND="provision"
DOT_JAY_REPO="${DEFAULT_DOT_JAY_REPO}"
DOT_JAY_REF="${DEFAULT_DOT_JAY_REF}"
DOT_JAY_BUNDLE_URL="${DEFAULT_DOT_JAY_BUNDLE_URL}"
DOT_JAY_BUNDLE_SHA256="${DEFAULT_DOT_JAY_BUNDLE_SHA256}"
GIT_SOURCE_EXPLICIT=false
BUNDLE_SOURCE_EXPLICIT=false
SWAP_GIB=2

if [[ "${1:-}" == "render" ]]; then
  COMMAND="render"
  shift
fi

usage() {
  cat <<'EOF'
Usage: jlx-cloud [options]
       jlx-cloud render [options]

Provision an Ubuntu cloud VM and apply its pinned dot-jay profile.
Use "render" to generate paste-ready cloud-init YAML without changing this host.

Options:
  --host                 Use the jlx-cloud-host profile with jq and htop.
                         The default jlx-cloud profile uses the minimal Linux
                         CLI package set, including tmux.
  --provider PROVIDER    ubuntu or oci (default: ubuntu).
  --user USER            Login user configured by the cloud image (default: ubuntu).
  --dot-jay-ref REF      Override the pinned dot-jay commit or release ref.
  --dot-jay-repo URL     Override the dot-jay Git repository.
  --dot-jay-bundle-url URL
                         Override the released dot-jay runtime bundle URL.
  --dot-jay-bundle-sha256 SHA256
                         Override the runtime bundle checksum.
  --swap-gib SIZE        OCI emergency swap size, 0 through 16 (default: 2).
  --dry-run              Print the resolved provisioning plan without changing the host.
  --version              Show the jlx-cloud version.
  -h, --help             Show this help.
EOF
}

fail() {
  printf '[jlx-cloud] ERROR: %s\n' "$*" >&2
  exit 1
}

while (($#)); do
  case "$1" in
    --host)
      HOST_MODE=true
      shift
      ;;
    --provider)
      [[ $# -ge 2 ]] || fail "--provider requires a value"
      PROVIDER="$2"
      shift 2
      ;;
    --user)
      [[ $# -ge 2 ]] || fail "--user requires a value"
      TARGET_USER="$2"
      shift 2
      ;;
    --dot-jay-ref)
      [[ $# -ge 2 ]] || fail "--dot-jay-ref requires a value"
      DOT_JAY_REF="$2"
      GIT_SOURCE_EXPLICIT=true
      shift 2
      ;;
    --dot-jay-repo)
      [[ $# -ge 2 ]] || fail "--dot-jay-repo requires a value"
      DOT_JAY_REPO="$2"
      GIT_SOURCE_EXPLICIT=true
      shift 2
      ;;
    --dot-jay-bundle-url)
      [[ $# -ge 2 ]] || fail "--dot-jay-bundle-url requires a value"
      DOT_JAY_BUNDLE_URL="$2"
      BUNDLE_SOURCE_EXPLICIT=true
      shift 2
      ;;
    --dot-jay-bundle-sha256)
      [[ $# -ge 2 ]] || fail "--dot-jay-bundle-sha256 requires a value"
      DOT_JAY_BUNDLE_SHA256="$2"
      BUNDLE_SOURCE_EXPLICIT=true
      shift 2
      ;;
    --swap-gib)
      [[ $# -ge 2 ]] || fail "--swap-gib requires a value"
      SWAP_GIB="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --version)
      printf 'jlx-cloud %s\n' "${JLX_CLOUD_VERSION}"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "Unknown option: $1"
      ;;
  esac
done

[[ "${PROVIDER}" == "ubuntu" || "${PROVIDER}" == "oci" ]] || \
  fail "--provider must be 'ubuntu' or 'oci'"
[[ "${SWAP_GIB}" =~ ^([0-9]|1[0-6])$ ]] || \
  fail "--swap-gib must be an integer from 0 through 16"
[[ -n "${TARGET_USER}" ]] || fail "--user must not be blank"
[[ -n "${DOT_JAY_REPO}" ]] || fail "--dot-jay-repo must not be blank"
[[ -n "${DOT_JAY_REF}" ]] || fail "--dot-jay-ref must not be blank"
[[ "${GIT_SOURCE_EXPLICIT}" == false || "${BUNDLE_SOURCE_EXPLICIT}" == false ]] || \
  fail "Git source overrides cannot be combined with bundle source overrides"

USE_DOT_JAY_BUNDLE=true
if [[ "${GIT_SOURCE_EXPLICIT}" == true ]]; then
  USE_DOT_JAY_BUNDLE=false
else
  [[ -n "${DOT_JAY_BUNDLE_URL}" ]] || fail "--dot-jay-bundle-url must not be blank"
  [[ "${DOT_JAY_BUNDLE_SHA256}" =~ ^[0-9a-fA-F]{64}$ ]] || \
    fail "--dot-jay-bundle-sha256 must contain 64 hexadecimal characters"
fi

if [[ "${COMMAND}" == "render" ]]; then
  [[ "${DRY_RUN}" == false ]] || fail "--dry-run cannot be combined with render"
  [[ "${GIT_SOURCE_EXPLICIT}" == false && "${BUNDLE_SOURCE_EXPLICIT}" == false ]] || \
    fail "dot-jay source overrides are not supported by render"

  render_args=(
    --provider "${PROVIDER}"
    --user "${TARGET_USER}"
    --swap-gib "${SWAP_GIB}"
  )
  if [[ "${HOST_MODE}" == true ]]; then
    render_args+=(--host)
  fi

  exec python3 "${SCRIPT_DIR}/scripts/render-cloud-init.py" "${render_args[@]}"
fi

DOT_JAY_PROFILE="jlx-cloud"
if [[ "${HOST_MODE}" == true ]]; then
  DOT_JAY_PROFILE="jlx-cloud-host"
fi

if [[ "${DRY_RUN}" == true ]]; then
  printf 'provider=%s\n' "${PROVIDER}"
  printf 'profile=%s\n' "${DOT_JAY_PROFILE}"
  printf 'target-user=%s\n' "${TARGET_USER}"
  printf 'dot-jay-ref=%s\n' "${DOT_JAY_REF}"
  if [[ "${USE_DOT_JAY_BUNDLE}" == true ]]; then
    printf 'dot-jay-source=bundle\n'
    printf 'dot-jay-bundle-url=%s\n' "${DOT_JAY_BUNDLE_URL}"
  else
    printf 'dot-jay-source=git\n'
    printf 'dot-jay-repo=%s\n' "${DOT_JAY_REPO}"
  fi
  if [[ "${PROVIDER}" == "oci" ]]; then
    printf 'swap-gib=%s\n' "${SWAP_GIB}"
  fi
  exit 0
fi

[[ "${EUID}" -eq 0 ]] || fail "Run jlx-cloud as root (cloud-init does this automatically)"

common_args=(
  --user "${TARGET_USER}"
  --profile "${DOT_JAY_PROFILE}"
  --dot-jay-ref "${DOT_JAY_REF}"
)
if [[ "${USE_DOT_JAY_BUNDLE}" == true ]]; then
  common_args+=(
    --dot-jay-bundle-url "${DOT_JAY_BUNDLE_URL}"
    --dot-jay-bundle-sha256 "${DOT_JAY_BUNDLE_SHA256}"
  )
else
  common_args+=(
    --dot-jay-repo "${DOT_JAY_REPO}"
    --dot-jay-bundle-url ""
  )
fi

case "${PROVIDER}" in
  ubuntu)
    exec "${SCRIPT_DIR}/scripts/bootstrap-ubuntu.sh" "${common_args[@]}" --firewall ufw
    ;;
  oci)
    exec "${SCRIPT_DIR}/scripts/bootstrap-oci.sh" "${common_args[@]}" --swap-gib "${SWAP_GIB}"
    ;;
esac
